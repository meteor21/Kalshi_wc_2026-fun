# --- Kalshi (required) ---
KALSHI_ENV=demo                              # demo | prod. Never default prod.
KALSHI_KEY_ID=your-key-id
KALSHI_PRIVATE_KEY_PATH=./kalshi_demo_key.pem
# ALLOW_PROD=1                               # required guard to let run_cycle trade prod

# --- API-Football (soccer data + live trigger watcher) ---
API_FOOTBALL_KEY=your-api-football-key
# SOCCER_CACHE=data/api_football             # on-disk cache dir for pulls

# --- model wiring (optional) ---
# KALSHI_TENNIS_SERIES=                       # Kalshi series ticker for tennis markets
# KALSHI_SOCCER_SERIES=                       # Kalshi series ticker for soccer markets
# SOCCER_TRIGGER_BETTING=1                    # phase-0 default OFF (log-only); 1 to enable bets
